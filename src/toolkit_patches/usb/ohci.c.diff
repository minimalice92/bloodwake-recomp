+/* Blood Wake carried patch (lane au-iso): an arrival line with when it
+ * happened -- ms since the controller thread started, the passes so far and
+ * their mean length, and the host counter in ms (h=, as BW_STEPLOG prints
+ * it) -- so a pad that arrives late can be measured against the game. One
+ * fprintf, so another thread's line can't land in the middle. */
+static void ohci_arrival_line(const char *what, unsigned long passes,
+                              const LARGE_INTEGER *start, const LARGE_INTEGER *freq)
+{
+    LARGE_INTEGER now;
+    double ms, f = freq->QuadPart ? (double)freq->QuadPart : 1.0;
+
+    QueryPerformanceCounter(&now);
+    ms = (double)(now.QuadPart - start->QuadPart) * 1000.0 / f;
+    fprintf(stderr, "  [OHCI0] %s (t=%.0f ms, pass %lu, %.2f ms a pass, h=%.1f)\n", what, ms,
+            passes, passes ? ms / (double)passes : 0.0, (double)now.QuadPart * 1000.0 / f);
+    fflush(stderr);
+}
