+                            " (the worst of 6 s plus %.2f ms, at least %.2f; right after the pass when that"
+                            " leaves no room, and for 20 s after a short pass) (BW_WASAPI_LEAD=auto)\n",
+                    g_lead_margin_us / 1000.0, XA2_LEAD_MIN_US / 1000.0);
+        } else if (e && *e) {
