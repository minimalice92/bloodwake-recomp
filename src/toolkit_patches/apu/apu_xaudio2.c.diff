+        g_cost_max[g_cost_slot] = 0;
+        g_cost_t0 = now;
+    }
+    if (cost > g_cost_max[g_cost_slot])
+        g_cost_max[g_cost_slot] = cost;
+    if (cost > g_lead_cost_worst_line)
+        g_lead_cost_worst_line = cost;
+    for (i = 0; i < XA2_COST_SLOTS; i++)
+        if (g_cost_max[i] > worst)
+            worst = g_cost_max[i];
+    want = worst + g_lead_margin_us;
+    if (want < XA2_LEAD_MIN_US)
+        want = XA2_LEAD_MIN_US;
+    if (g_cost_filled < XA2_COST_SLOTS - 1 || now < g_lead_off_until || want > pass_us - 1000)
+        want = 0;                          /* right after the pass */
+    if (want != g_lead_cur) {
+        if ((want == 0) != (g_lead_cur == 0) && g_lead_logged++ < 100)
+            fprintf(stderr, "[XA2] WASAPI: the lead %s (the worst top-up of the last %d s %.2f ms)\n",
+                    want ? "on" : "off: topped up right after each pass", XA2_COST_SLOTS, worst / 1000.0);
+        g_lead_cur = want;
+        g_lead_changes++;
+    }
+}
