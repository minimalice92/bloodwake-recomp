+/* Blood Wake (lat-a): BW_XA2_STATS / BW_LATLOG, every 5 s and at shutdown. */
+static void xa2_stat_line(const char *when)
+{
+    XAUDIO2_PERFORMANCE_DATA pd;
+    memset(&pd, 0, sizeof pd);
+    if (g_xa2)
+        IXAudio2_GetPerformanceData(g_xa2, &pd);
+    if (!g_wa)
+    fprintf(stderr, "[XA2-STAT] %s: passes %ld, starved %ld (%.1f ms of silence), during a pause %ld;"
+            " XAudio2 glitches %u, its latency %u samples (%.1f ms); underruns %u; submitted %llu\n",
+            when, (long)g_xa2_passes, (long)g_xa2_starved_passes,
+            (double)g_xa2_starved_bytes / (2.0 * XA2_CHANNELS) / 48.0, (long)g_xa2_drain_passes,
+            pd.GlitchesSinceEngineStarted, pd.CurrentLatencyInSamples,
+            pd.CurrentLatencyInSamples / 48.0, g_xa2_underruns, (unsigned long long)g_xa2_submitted);
+    fprintf(stderr, "[XA2-STAT] %s: %s; short passes %ld (%.1f ms of silence; from the played count);"
+            " underruns %u; submitted %llu", when,
+            g_wa ? (bw_wa_exclusive() ? "WASAPI exclusive mode" : "WASAPI shared mode") : "XAudio2", g_st_short,
+            g_st_short_frames / 48.0, g_xa2_underruns, (unsigned long long)g_xa2_submitted);
+    if (g_wa) {
+        uint64_t fr;
+        int64_t q;
+        LARGE_INTEGER now, f;
+        if (bw_wa_clock(&fr, &q)) {
+            /* the stream's clock: read but not yet played, as Windows reports it */
+            QueryPerformanceCounter(&now);
+            QueryPerformanceFrequency(&f);
+            fprintf(stderr, "; read but not yet playing %.1f ms (the stream's clock)",
+                    ((double)bw_wa_consumed() - (double)fr
+                     - (double)(now.QuadPart - q) * 48000.0 / (double)f.QuadPart) / 48.0);
+        }
+        {
+            /* au-out: the queue just before each write since the last line */
+            int mn = 0, p1 = 0, med = 0;
+            if (bw_wa_queue_stats(&mn, &p1, &med))
+                fprintf(stderr, "; queue before each write min %.1f p1 %.1f median %.1f ms (%s, period %d)",
+                        mn / 48.0, p1 / 48.0, med / 48.0, bw_wa_event() ? "event-driven" : "polled",
+                        bw_wa_period());
+            xa2_slack_line();
+        }
+        if (bw_wa_exclusive()) {
+            /* au-lat: the device's periods the output thread handed short */
+            double xm = 0;
+            long xs = bw_wa_excl_shorts(&xm);
+            fprintf(stderr, "; exclusive periods handed short %ld (%.1f ms of silence)", xs, xm);
+        }
+    }
+    fprintf(stderr, "\n");
+}
+
+/* Blood Wake (lat-a): at each queue poll (stats on), the played count against
+ * the last poll's: a move that is not a whole number of passes is a short
+ * pass. With BW_LATLOG on the WASAPI output, each move is also a J event (the
+ * pass happened between the polls; its time is the polls' midpoint) and the
+ * stream's clock an H event. */
+static void xa2_stat_poll(void)
+{
+    uint64_t pl = xa2_samples_played();
+    int64_t now = g_bw_lat_on ? bw_lat_now() : 0;
+    if (pl > g_st_played_last && g_st_played_last && g_xa2_submitted && !g_xa2_draining) {
+        uint64_t j = pl - g_st_played_last;
+        if (j % XA2_PASS) {
+            g_st_short++;
+            g_st_short_frames += XA2_PASS - (int64_t)(j % XA2_PASS);
+        }
+        if (g_bw_lat_on && g_wa) {
+            uint64_t k, n = (j + XA2_PASS - 1) / XA2_PASS;
+            for (k = 0; k < n; k++)
+                bw_lat_ev(BW_LAT_XPASS, g_st_last_poll_qpc + (now - g_st_last_poll_qpc) * (int64_t)(2 * k + 1)
+                                            / (int64_t)(2 * n),
+                          0, (int64_t)(g_st_played_last + k * XA2_PASS), -1, (int64_t)g_xa2_submitted,
+                          g_xa2_draining, 1, 0.0, 0.0);
+        }
+    }
+    if (pl >= g_st_played_last)
+        g_st_played_last = pl;
+    if (g_bw_lat_on && g_wa) {
+        uint64_t fr;
+        int64_t q;
+        if (bw_wa_clock(&fr, &q))
+            bw_lat_ev(BW_LAT_WCLOCK, q, (int64_t)(g_xa2_played_base + fr), (int64_t)pl, 0, 0, 0, 0, 0.0, 0.0);
+    }
+    g_st_last_poll_qpc = now;
+}
