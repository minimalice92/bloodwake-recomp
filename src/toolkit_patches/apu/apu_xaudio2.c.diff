+/* Blood Wake (lat-a, BW_LATLOG only): what Windows says about the default
+ * output device, read only (no stream is opened, nothing is changed): its
+ * name, mix format, WASAPI's device periods and the shared engine's periods.
+ * Logged as one line and a K event with a = -1. */
+static void xa2_lat_device_info(void)
+{
+    static const GUID iid_ac  = { 0x1CB9AD4C, 0xDBFA, 0x4C32,
+                                  { 0xB1, 0x78, 0xC2, 0xF5, 0x68, 0xA7, 0x03, 0xB2 } };
+    static const GUID iid_ac3 = { 0x7ED4EE07, 0x8E67, 0x4CD4,
+                                  { 0x8C, 0x1A, 0x2B, 0x7A, 0x59, 0x87, 0xAD, 0x42 } };
+    static const PROPERTYKEY k_name = { { 0xA45C254E, 0xDF1C, 0x4EFD,
+                                          { 0x80, 0x20, 0x67, 0xD1, 0x46, 0xA8, 0x50, 0xE0 } }, 14 };
+    IMMDevice *dev = NULL;
+    IAudioClient *ac = NULL;
+    IAudioClient3 *ac3 = NULL;
+    IPropertyStore *ps = NULL;
+    WAVEFORMATEX *mix = NULL;
+    REFERENCE_TIME def = 0, mn = 0;
+    UINT32 p_def = 0, p_fund = 0, p_min = 0, p_max = 0, p_cur = 0;
+    char name[200] = "?";
+    if (!s_mmde || FAILED(IMMDeviceEnumerator_GetDefaultAudioEndpoint(s_mmde, eRender, eConsole, &dev))) {
+        fprintf(stderr, "[XA2] lat: no default output device to describe\n");
+        return;
+    }
+    if (SUCCEEDED(IMMDevice_OpenPropertyStore(dev, STGM_READ, &ps))) {
+        PROPVARIANT pv;
+        PropVariantInit(&pv);
+        if (SUCCEEDED(IPropertyStore_GetValue(ps, &k_name, &pv)) && pv.vt == VT_LPWSTR && pv.pwszVal)
+            WideCharToMultiByte(CP_UTF8, 0, pv.pwszVal, -1, name, (int)sizeof name, NULL, NULL);
+        PropVariantClear(&pv);
+        IPropertyStore_Release(ps);
+    }
+    if (SUCCEEDED(IMMDevice_Activate(dev, &iid_ac, CLSCTX_ALL, NULL, (void **)&ac))) {
+        IAudioClient_GetDevicePeriod(ac, &def, &mn);
+        IAudioClient_GetMixFormat(ac, &mix);
+        if (mix && SUCCEEDED(IAudioClient_QueryInterface(ac, &iid_ac3, (void **)&ac3))) {
+            WAVEFORMATEX *cur = NULL;
+            IAudioClient3_GetSharedModeEnginePeriod(ac3, mix, &p_def, &p_fund, &p_min, &p_max);
+            if (SUCCEEDED(IAudioClient3_GetCurrentSharedModeEnginePeriod(ac3, &cur, &p_cur)) && cur)
+                CoTaskMemFree(cur);
+            IAudioClient3_Release(ac3);
+        }
+        IAudioClient_Release(ac);
+    }
+    {
+        /* What a plain WASAPI shared stream of the smallest buffer would have
+         * (for the report's options): initialized, never started, released. */
+        IAudioClient *ac2 = NULL;
+        if (mix && SUCCEEDED(IMMDevice_Activate(dev, &iid_ac, CLSCTX_ALL, NULL, (void **)&ac2))) {
+            REFERENCE_TIME sl = 0;
+            UINT32 bs = 0;
+            HRESULT h2 = IAudioClient_Initialize(ac2, AUDCLNT_SHAREMODE_SHARED,
+                                                 AUDCLNT_STREAMFLAGS_EVENTCALLBACK, 0, 0, mix, NULL);
+            if (SUCCEEDED(h2)) {
+                IAudioClient_GetStreamLatency(ac2, &sl);
+                IAudioClient_GetBufferSize(ac2, &bs);
+            }
+            fprintf(stderr, "[XA2] lat: a plain WASAPI shared stream there: %s, stream latency %.2f ms,"
+                    " buffer %u frames (%.2f ms); never started\n", SUCCEEDED(h2) ? "ok" : "refused",
+                    sl / 1e4, bs, mix->nSamplesPerSec ? bs * 1000.0 / mix->nSamplesPerSec : 0.0);
+            IAudioClient_Release(ac2);
+        }
+    }
+    IMMDevice_Release(dev);
+    fprintf(stderr, "[XA2] lat: default output \"%s\": mix %lu Hz %u ch; WASAPI device period %.2f ms"
+            " (minimum %.2f); shared engine period now %u frames (default %u, fundamental %u, %u..%u)\n",
+            name, mix ? (unsigned long)mix->nSamplesPerSec : 0ul, mix ? mix->nChannels : 0,
+            def / 1e4, mn / 1e4, p_cur, p_def, p_fund, p_min, p_max);
+    bw_lat_ev(BW_LAT_XPERF, bw_lat_now(), -1, (int64_t)def, (int64_t)mn, p_def, p_fund, p_min,
+              mix ? (double)mix->nSamplesPerSec : 0.0, (double)p_cur);
+    if (mix)
+        CoTaskMemFree(mix);
+}
