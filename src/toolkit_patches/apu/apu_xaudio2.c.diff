+/* Destroy the voices and the engine (the COM state stays). */
+static void xa2_release(void)
+{
+    if (g_wa) {                          /* Blood Wake (lat-a) */
+        bw_wa_release();
+        return;
+    }
+    if (g_xa2_source) {
+        IXAudio2SourceVoice_Stop(g_xa2_source, 0, XAUDIO2_COMMIT_NOW);
+        IXAudio2SourceVoice_FlushSourceBuffers(g_xa2_source);
+        g_xa2_source->lpVtbl->DestroyVoice(g_xa2_source);
+        g_xa2_source = NULL;
+    }
+    if (g_xa2_master) {
+        g_xa2_master->lpVtbl->DestroyVoice(g_xa2_master);
+        g_xa2_master = NULL;
+    }
+    if (g_xa2) {
+        IXAudio2_Release(g_xa2);
+        g_xa2 = NULL;
+    }
+}
+
+/* BW_TEST_AUDIO_NODEVICE (item 105): an open in the window fails as if Windows
+ * had no output device (0x80070490), for the no-device wait and its retries
+ * (0-8000: no device at start). On either output (lat-a). */
+static int xa2_test_nodevice(int quiet)
+{
+    static int parsed;
+    static ULONGLONG t0;
+    static unsigned long a, b;
+    ULONGLONG now = GetTickCount64();
+    if (!parsed) {
+        const char *e = getenv("BW_TEST_AUDIO_NODEVICE");
+        parsed = 1;
+        t0 = now;
+        if (e && *e) {
+            char *end;
+            a = strtoul(e, &end, 10);
+            b = *end == '-' ? strtoul(end + 1, NULL, 10) : 0;
+        }
+    }
+    if (b > a && now - t0 >= a && now - t0 < b) {
+        if (!quiet)
+            fprintf(stderr, "[XA2] test: no audio device (BW_TEST_AUDIO_NODEVICE, %llu ms)\n",
+                    (unsigned long long)(now - t0));
+        return 1;
+    }
+    return 0;
+}
+
+/* Blood Wake (au-out): the XAudio2 objects of one output, so a rebuild can
+ * open a new set on the output worker while the frame thread keeps the live
+ * one (the globals) until the swap. */
+typedef struct {
+    IXAudio2               *x;
+    IXAudio2MasteringVoice *m;
+    IXAudio2SourceVoice    *s;
+} Xa2Set;
+static Xa2Set s_xa_next;
+
+static void xa2_set_release(Xa2Set *o)
+{
+    if (o->s) {
+        IXAudio2SourceVoice_Stop(o->s, 0, XAUDIO2_COMMIT_NOW);
+        IXAudio2SourceVoice_FlushSourceBuffers(o->s);
+        o->s->lpVtbl->DestroyVoice(o->s);
+    }
+    if (o->m)
+        o->m->lpVtbl->DestroyVoice(o->m);
+    if (o->x)
+        IXAudio2_Release(o->x);
+    memset(o, 0, sizeof *o);
+}
+
+/* The engine, a mastering voice on the default device, and the source voice
+ * (started unless start is 0: a set opened on the worker starts at the swap).
+ * At boot it also decides the layout (5.1 or stereo); a rebuild keeps it.
+ * quiet: no failure lines (retries while no device is there). */
+static HRESULT xa2_open_set(Xa2Set *o, int boot, int quiet, int start)
+{
+    HRESULT hr;
+    WAVEFORMATEX wfx = { 0 };
+
+    /* lat-a test switches (any edition; never in a preset): XAudio2's own
+     * flags, hex (BW_XA2_CREATE_FLAGS for XAudio2Create, BW_XA2_MASTER_FLAGS
+     * for the mastering voice, e.g. 10000 = XAUDIO2_NO_VIRTUAL_AUDIO_CLIENT) */
+    UINT32 cflags = (UINT32)strtoul(getenv("BW_XA2_CREATE_FLAGS") ? getenv("BW_XA2_CREATE_FLAGS") : "0", NULL, 16);
+    UINT32 mflags = (UINT32)strtoul(getenv("BW_XA2_MASTER_FLAGS") ? getenv("BW_XA2_MASTER_FLAGS") : "0", NULL, 16);
+    hr = XAudio2Create(&o->x, cflags, XAUDIO2_DEFAULT_PROCESSOR);
+    if (FAILED(hr) || !o->x) {
+        if (!quiet)
+            fprintf(stderr, "[XA2] XAudio2Create failed: 0x%08lX\n", hr);
+        return FAILED(hr) ? hr : E_FAIL;
+    }
+    IXAudio2_RegisterForCallbacks(o->x, &s_ecb);
+    if (xa2_test_nodevice(quiet))        /* item 105's test switch */
+        return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+
+    /* Blood Wake: the device's own channel count decides whether a 5.1
+     * source voice is wanted; without one, a 2-channel mastering voice as
+     * before. */
+    {
+        int dev_ch = 2;
+        XAUDIO2_VOICE_DETAILS det;
+        wchar_t tdev[400];               /* au-out: BW_TEST_AUDIO_DEVICE (a test), or the default */
+        LPCWSTR dev_id = bw_out_test_device_xa2(tdev, sizeof tdev / sizeof tdev[0]) ? tdev : NULL;
+        hr = IXAudio2_CreateMasteringVoice(o->x, &o->m,
+            XAUDIO2_DEFAULT_CHANNELS, XA2_SAMPLE_RATE, mflags, dev_id, NULL, 0);
+        if (SUCCEEDED(hr) && o->m) {
+            o->m->lpVtbl->GetVoiceDetails(o->m, &det);
+            dev_ch = (int)det.InputChannels;
+        }
+        if (boot)
+            g_xa2_channels = bw_surround_output_wanted(dev_ch) ? 6 : 2;
+        if (o->m && (FAILED(hr) || (g_xa2_channels == 2 && dev_ch != 2))) {
+            o->m->lpVtbl->DestroyVoice(o->m);
+            o->m = NULL;
+        }
+        if (!o->m)
+            hr = IXAudio2_CreateMasteringVoice(o->x, &o->m,
+                2, XA2_SAMPLE_RATE, mflags, dev_id, NULL, 0);
+        if (boot || SUCCEEDED(hr))
+            fprintf(stderr, "[XA2] the audio device has %d channels; output: %s\n", dev_ch,
+                    g_xa2_channels == 6 ? "5.1 (6 channels)" : "stereo");
+    }
+    if (FAILED(hr)) {
+        if (!quiet)
+            fprintf(stderr, "[XA2] CreateMasteringVoice failed: 0x%08lX\n", hr);
+        return hr;
+    }
+
+    wfx.wFormatTag      = WAVE_FORMAT_PCM;
+    wfx.nChannels       = XA2_CHANNELS;
+    wfx.nSamplesPerSec  = XA2_SAMPLE_RATE;
+    wfx.wBitsPerSample  = 16;
+    wfx.nBlockAlign     = XA2_CHANNELS * 2;
+    wfx.nAvgBytesPerSec = XA2_SAMPLE_RATE * wfx.nBlockAlign;
+
+    if (g_xa2_channels == 6) {
+        /* Blood Wake: 5.1 with its channel mask, so XAudio2 maps it onto any
+         * device (and downmixes it on a stereo one) */
+        WAVEFORMATEXTENSIBLE wfe;
+        static const GUID pcm = { 0x00000001, 0x0000, 0x0010,
+                                  { 0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71 } };
+        memset(&wfe, 0, sizeof(wfe));
+        wfe.Format = wfx;
+        wfe.Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
+        wfe.Format.cbSize = (WORD)(sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX));
+        wfe.Samples.wValidBitsPerSample = 16;
+        wfe.dwChannelMask = 0x3F;                    /* FL FR FC LFE BL BR */
+        wfe.SubFormat = pcm;
+        hr = IXAudio2_CreateSourceVoice(o->x, &o->s,
+            (const WAVEFORMATEX *)&wfe, 0, XAUDIO2_DEFAULT_FREQ_RATIO,
+            g_xa2_stat_on ? &s_vcb : NULL, NULL, NULL);
+    } else {
+        hr = IXAudio2_CreateSourceVoice(o->x, &o->s,
+            &wfx, 0, XAUDIO2_DEFAULT_FREQ_RATIO, g_xa2_stat_on ? &s_vcb : NULL, NULL, NULL);
+    }
+    if (FAILED(hr)) {
+        if (!quiet)
+            fprintf(stderr, "[XA2] CreateSourceVoice failed: 0x%08lX\n", hr);
+        return hr;
+    }
+
+    if (start) {
+        hr = IXAudio2SourceVoice_Start(o->s, 0, XAUDIO2_COMMIT_NOW);
+        if (FAILED(hr)) {
+            if (!quiet)
+                fprintf(stderr, "[XA2] Start failed: 0x%08lX\n", hr);
+            return hr;
+        }
+    }
+    {
+        /* au-out: the device in full, in one line (the bug report reads it).
+         * XAudio2's mastering voice is on Windows' default output. */
+        char desc[440];
+        if (bw_out_describe(NULL, desc, sizeof desc))
+            fprintf(stderr, "[XA2] output device: %s; XAudio2 on %s, its own processing quantum (10 ms);"
+                    " our voice %d Hz %d ch 16-bit\n", desc,
+                    getenv("BW_TEST_AUDIO_DEVICE") ? "the test switch's device" : "Windows' default output",
+                    XA2_SAMPLE_RATE, g_xa2_channels);
+    }
+    return S_OK;
+}
+
+/* The live output: the WASAPI stream (bw_apu_wasapi.c), or a set made into
+ * the globals. */
+static HRESULT xa2_open(int boot, int quiet)
+{
+    Xa2Set o;
+    HRESULT hr;
+
+    if (g_wa) {                          /* Blood Wake (lat-a): the WASAPI stream */
+        if (xa2_test_nodevice(quiet))
+            return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+        return (HRESULT)bw_wa_open(boot, quiet, &g_xa2_channels);
+    }
+    memset(&o, 0, sizeof o);
+    hr = xa2_open_set(&o, boot, quiet, 1);
+    g_xa2 = o.x;                         /* a part made before a failure: xa2_release */
+    g_xa2_master = o.m;
+    g_xa2_source = o.s;
+    return hr;
+}
+
+/* Blood Wake (lat-a): a WASAPI call failed: the stream is dead. Keep what it
+ * played, let it go (its every later call would fail too) and flag the loss
+ * for xa2_check_device, as XAudio2's critical error does. */
+static void xa2_wa_failed(long hr)
+{
+    g_xa2_lost_hr = hr;
+    if (bw_wa_active()) {
+        g_xa2_played_base += bw_wa_consumed();
+        bw_wa_release();
+    }
+    InterlockedCompareExchange(&g_xa2_lost, 5, 0);
+}
+
+/* Blood Wake (lat-a): the current voice or stream, whichever output. */
+static int xa2_have_voice(void)
+{
+    return g_wa ? bw_wa_active() : g_xa2_source != NULL;
+}
+
+/* Samples the current voice or stream has had read since it was made. */
+static uint64_t xa2_voice_played(void)
+{
+    XAUDIO2_VOICE_STATE st;
+    if (g_wa)
+        return bw_wa_active() ? bw_wa_consumed() : 0;
+    if (!g_xa2_source)
+        return 0;
+    IXAudio2SourceVoice_GetState(g_xa2_source, &st, 0);
+    return st.SamplesPlayed;
+}
+
+/* BW_TEST_AUDIO_LOST: the next test time (ms after init) due, or 0. Up to
+ * 32 times (au-fx: 8 before; the many-losses case takes 28 in one boot). */
+static ULONGLONG test_lost_due(ULONGLONG since)
+{
+    static int parsed;
+    static ULONGLONG at[32];
+    static int n, next;
+    if (!parsed) {
+        const char *e = getenv("BW_TEST_AUDIO_LOST");
+        parsed = 1;
+        while (e && *e && n < 32) {
+            char *end;
+            unsigned long v = strtoul(e, &end, 10);
+            if (end == e)
+                break;
+            at[n++] = v;
+            e = end;
+            while (*e == ',' || *e == ' ')
+                e++;
+        }
+    }
+    if (next < n && since >= at[next])
+        return at[next++];
+    return 0;
+}
+
+/* BW_TEST_AUDIO_NEWDEFAULT (au-out): the next time (ms after init) due for a
+ * default-device notice as Windows sends one, or 0. The device stays and keeps
+ * playing: the rebuild follows "the new default", which is the same device. */
+static ULONGLONG test_newdefault_due(ULONGLONG since)
+{
+    static int parsed;
+    static ULONGLONG at[32];
+    static int n, next;
+    if (!parsed) {
+        const char *e = getenv("BW_TEST_AUDIO_NEWDEFAULT");
+        parsed = 1;
+        while (e && *e && n < 32) {
+            char *end;
+            unsigned long v = strtoul(e, &end, 10);
+            if (end == e)
+                break;
+            at[n++] = v;
+            e = end;
+            while (*e == ',' || *e == ' ')
+                e++;
+        }
+    }
+    if (next < n && since >= at[next])
+        return at[next++];
+    return 0;
+}
+
+/* BW_TEST_AUDIO_STALL (item 105): the next stall time (ms after init) due, or 0. */
+static ULONGLONG test_stall_due(ULONGLONG since)
+{
+    static int parsed;
+    static ULONGLONG at[16];
+    static int n, next;
+    if (!parsed) {
+        const char *e = getenv("BW_TEST_AUDIO_STALL");
+        parsed = 1;
+        while (e && *e && n < 16) {
+            char *end;
+            unsigned long v = strtoul(e, &end, 10);
+            if (end == e)
+                break;
+            at[n++] = v;
+            e = end;
+            while (*e == ',' || *e == ' ')
+                e++;
+        }
+    }
+    if (next < n && since >= at[next])
+        return at[next++];
+    return 0;
+}
+
+/* ---- Blood Wake (au-out): the rebuild on the output worker ---------------
+ *
+ * Item 68's rebuild opened the new device on the APU frame thread: 5-38 ms
+ * of no periods there (lat-a), 190-550 ms in item 68's own runs, while the
+ * chip's clock (voices, notifications) stood still. Now the frame thread
+ * only takes the change; the new device is opened on the output worker
+ * (bw_apu_out.c) into a second set, and swapped in at the start of a period
+ * (xa2_check_device runs before each submit). Meanwhile:
+ *   - a lost device: there is no voice, so periods are dropped and the chip
+ *     runs on the host clock, as while waiting for a device (item 68);
+ *   - Windows has a new default device (its notice): the old device still
+ *     plays and keeps being fed until the swap, and on WASAPI what it held
+ *     and hadn't played yet is written to the new stream first, so the
+ *     sound carries on where it was (no gap, nothing twice);
+ *   - another change before the open is done: that open is let go and the
+ *     default device is opened again (flapping devices settle on the last).
+ * The layout stays the boot's (the game was told it once); Windows maps it
+ * onto whatever the new device has (XAudio2's mastering voice, or WASAPI's
+ * AUTOCONVERTPCM). Every edition by default (the audio rework's gate, call
+ * AO-3: a port fix, better than item 68's frame-thread rebuild in Original
+ * too); BW_AUDIO_REBUILD_WORKER=0 rebuilds on the frame thread as item 68 did. */
+static int      g_rb_worker = -1;
+static int      g_rb_open;             /* a set or stream is being opened on the worker */
+static int      g_rb_again;            /* a newer change came in meanwhile */
+static int      g_rb_keep;             /* the old output plays until the swap */
+static int      g_rb_wa;               /* the job opens a WASAPI stream (else XAudio2) */
+static int      g_rb_quiet;
+static LONGLONG g_rb_q0;               /* the change taken (performance counter) */
+static double   g_rb_ft_ms;            /* the frame thread's own part */
+static int      g_rb_releasing;        /* the worker is letting an old output go */
+static Xa2Set   s_xa_old;              /* a stopped XAudio2 set, let go on the worker */
+static uint64_t g_ev_last;             /* event-driven WASAPI: the played count at the last poll */
+
+static int xa2_rb_worker(void)
+{
+    if (g_rb_worker < 0) {
+        const char *e = getenv("BW_AUDIO_REBUILD_WORKER");
+        g_rb_worker = (e && *e) ? *e != '0' : 1;   /* every edition (call AO-3) */
+        if (g_rb_worker && bw_wa_exclusive_wanted()) {
+            /* au-lat: an exclusive stream holds its device, so the new one
+             * can't open while it lives: release first, then open (the frame
+             * thread's rebuild, item 68's) */
+            g_rb_worker = 0;
+            fprintf(stderr, "[XA2] WASAPI exclusive: a rebuild releases the old stream first (on the frame thread)\n");
+        }
+    }
+    return g_rb_worker;
+}
+
+/* Let the retired outputs go (on the worker). */
+static long xa2_rb_free_job(void *arg)
+{
+    (void)arg;
+    bw_wa_free_retired();
+    xa2_set_release(&s_xa_old);
+    return 0;
+}
+
+static long xa2_rb_job(void *arg)
+{
+    HRESULT hr;
+    xa2_rb_free_job(arg);
+    if (g_rb_wa) {
+        if (xa2_test_nodevice(g_rb_quiet))
+            return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+        return bw_wa_open_next(g_rb_quiet, g_xa2_channels);
+    }
+    memset(&s_xa_next, 0, sizeof s_xa_next);
+    hr = xa2_open_set(&s_xa_next, 0, g_rb_quiet, 0);
+    if (FAILED(hr))
+        xa2_set_release(&s_xa_next);
+    return hr;
+}
+
+static double xa2_qpc_ms(LONGLONG a, LONGLONG b)
+{
+    LARGE_INTEGER f;
+    QueryPerformanceFrequency(&f);
+    return (double)(b - a) * 1000.0 / (double)f.QuadPart;
+}
+
+/* The live voice or stream goes: what it played stays in the count, what it
+ * held is lost. defer: it is stopped here and let go on the worker (only
+ * while the worker runs no job). */
+static void xa2_rb_drop_live(int defer)
+{
+    g_xa2_played_base += xa2_voice_played();
+    g_xa2_submitted = g_xa2_played_base;
+    if (!defer)
+        xa2_release();
+    else if (g_wa)
+        bw_wa_retire();
+    else {
+        if (g_xa2_source)
+            IXAudio2SourceVoice_Stop(g_xa2_source, 0, XAUDIO2_COMMIT_NOW);
+        xa2_set_release(&s_xa_old);      /* none left over, normally */
+        s_xa_old.x = g_xa2;
+        s_xa_old.m = g_xa2_master;
+        s_xa_old.s = g_xa2_source;
+        g_xa2 = NULL;
+        g_xa2_master = NULL;
+        g_xa2_source = NULL;
+    }
+    g_st_played_last = g_xa2_played_base;
+    g_ev_last = g_xa2_played_base;
+    g_xa2_next_buf = 0;
+    g_xa2_fill = 0;
+    g_xa2_dry = 1;
+}
+
+/* Take a change (why, as g_xa2_lost) and post the open. 0: the worker can't
+ * be used (the caller rebuilds here, as before). */
+static int xa2_rb_start(LONG why, int first)
+{
+    LARGE_INTEGER a, b;
+    QueryPerformanceCounter(&a);
+    if (first) {
+        g_rb_q0 = a.QuadPart;
+        g_rb_ft_ms = 0;
+    }
+    g_rb_keep = why == 2 && xa2_have_voice() && !g_xa2_waiting;
+    if (!g_rb_keep && xa2_have_voice())
+        xa2_rb_drop_live(1);             /* the worker lets it go first */
+    g_rb_wa = g_wa;
+    g_rb_quiet = g_xa2_waiting;
+    if (!bw_out_post(xa2_rb_job, NULL))
+        return 0;
+    g_rb_open = 1;
+    QueryPerformanceCounter(&b);
+    g_rb_ft_ms += xa2_qpc_ms(a.QuadPart, b.QuadPart);
+    return 1;
+}
+
+/* The worker's open finished (hr, in job_ms): swap it in, or wait, or fall
+ * back to XAudio2, as the frame-thread rebuild does. */
+static void xa2_rb_finish(long hr, double job_ms)
+{
+    LARGE_INTEGER a, b;
+    ULONGLONG now = GetTickCount64();
+    int tail = 0;
+    QueryPerformanceCounter(&a);
+    g_rb_open = 0;
+    if (g_rb_again) {
+        g_rb_again = 0;
+        if (SUCCEEDED(hr)) {
+            if (g_rb_wa)
+                bw_wa_drop_next();
+            else
+                xa2_set_release(&s_xa_next);
+        }
+        if (!xa2_rb_start(2, 0))
+            InterlockedCompareExchange(&g_xa2_lost, 2, 0);   /* the worker is busy: next period */
+        return;
+    }
+    if (SUCCEEDED(hr)) {
+        if (g_rb_wa) {
+            uint64_t old = 0;
+            int had = bw_wa_active();
+            tail = bw_wa_adopt_next(g_rb_keep && had, &old);
+            if (had)
+                g_xa2_played_base += old;
+            if (tail < 0) {
+                /* it wouldn't start: counted as a lost device, tried again */
+                g_xa2_submitted = g_xa2_played_base;
+                g_st_played_last = g_xa2_played_base;
+                g_ev_last = g_xa2_played_base;
+                g_xa2_lost_hr = bw_wa_last_error();
+                InterlockedCompareExchange(&g_xa2_lost, 5, 0);
+                return;
+            }
+            g_xa2_submitted = g_xa2_played_base + (uint64_t)tail;
+        } else {
+            if (xa2_have_voice())
+                xa2_rb_drop_live(1);    /* the kept old voice, let go on the worker */
+            g_xa2 = s_xa_next.x;
+            g_xa2_master = s_xa_next.m;
+            g_xa2_source = s_xa_next.s;
+            memset(&s_xa_next, 0, sizeof s_xa_next);
+            IXAudio2SourceVoice_Start(g_xa2_source, 0, XAUDIO2_COMMIT_NOW);
+            g_xa2_submitted = g_xa2_played_base;
+        }
+        g_st_played_last = g_xa2_played_base;
+        g_ev_last = g_xa2_played_base;
+        g_xa2_next_buf = 0;
+        g_xa2_fill = 0;
+        g_xa2_dry = 1;
+        QueryPerformanceCounter(&b);
+        g_rb_ft_ms += xa2_qpc_ms(a.QuadPart, b.QuadPart);
+        if (g_xa2_quiet_events)
+            fprintf(stderr, "[XA2] (Windows changed its default device %u more times while there was "
+                    "none)\n", g_xa2_quiet_events);
+        g_xa2_quiet_events = 0;
+        g_xa2_waiting = 0;
+        g_xa2_rebuilds++;
+        g_xa2_rebuilt_at = now;
+        fprintf(stderr, "[XA2] rebuilt on the default audio device in %.1f ms (rebuild %u; opened on the"
+                " output worker in %.1f ms, the frame thread's part %.2f ms; %s, as the game was told at"
+                " boot%s%s); sound goes on\n", xa2_qpc_ms(g_rb_q0, b.QuadPart), g_xa2_rebuilds, job_ms,
+                g_rb_ft_ms, g_xa2_channels == 6 ? "5.1" : "stereo", g_wa ? "; WASAPI" : "",
+                g_rb_keep ? (tail > 0 ? "; the old device played until the swap, and what it still held"
+                                        " went on to the new one" : "; the old device played until the swap")
+                          : "");
+        if (g_rb_keep && tail > 0)
+            fprintf(stderr, "[XA2] (%d frames, %.1f ms, carried from the old device)\n", tail, tail / 48.0);
+        if (bw_out_post(xa2_rb_free_job, NULL))
+            g_rb_releasing = 1;          /* the old one goes on the worker */
+        else
+            xa2_rb_free_job(NULL);
+        return;
+    }
+    if (g_rb_wa && hr != HRESULT_FROM_WIN32(ERROR_NOT_FOUND) && hr != AUDCLNT_E_DEVICE_INVALIDATED) {
+        /* lat-a: a device is there but the stream won't open on it: the rest
+         * of this boot goes on with XAudio2 rather than waiting forever */
+        fprintf(stderr, "[XA2] the WASAPI output didn't reopen (0x%08lX): this boot goes on with"
+                " XAudio2\n", (unsigned long)hr);
+        if (xa2_have_voice())
+            xa2_rb_drop_live(1);
+        g_wa = 0;
+        if (!xa2_rb_start(0, 0))
+            InterlockedCompareExchange(&g_xa2_lost, 4, 0);
+        return;
+    }
+    if (g_rb_keep && xa2_have_voice()) {
+        fprintf(stderr, "[XA2] Windows' new default device didn't open (0x%08lX): the sound stays on the"
+                " device it was on\n", (unsigned long)hr);
+        return;
+    }
+    if (!g_xa2_waiting)
+        fprintf(stderr, "[XA2] no audio device (0x%08lX, %.1f ms to find out on the output worker): the game"
+                " runs silent and tries again when Windows has a device (or every 5 s)\n",
+                (unsigned long)hr, job_ms);
+    g_xa2_waiting = 1;
+    g_xa2_retry_at = now + 5000;         /* Windows' notice usually comes first */
+}
+
+/* The APU frame thread, before each submit (and while the queue is stalled,
+ * item 105): a lost or changed device is rebuilt here (see above). */
+static void xa2_check_device(void)
+{
+    ULONGLONG now = GetTickCount64(), t;
+    LONG why;
+    LARGE_INTEGER f, q0, q1;
+    HRESULT hr;
+    static const char *const k_why[] = { "", "XAudio2 reported a critical error",
+                                         "Windows has a new default audio device",
+                                         "test switch BW_TEST_AUDIO_LOST",
+                                         "the device has taken no sound for a second",
+                                         "the WASAPI stream failed (its device went away)" };
+
+    if ((t = test_lost_due(now - g_xa2_t0)) != 0) {
+        if (g_wa)
+            bw_wa_stop();                /* Blood Wake (lat-a): the stream stops consuming */
+        else if (g_xa2_source)
+            IXAudio2SourceVoice_Stop(g_xa2_source, 0, XAUDIO2_COMMIT_NOW);
+        fprintf(stderr, "[XA2] test: the audio device is lost at %llu ms (the voice stops "
+                "consuming)\n", (unsigned long long)t);
+        InterlockedExchange(&g_xa2_lost, 3);
+    }
+    if ((t = test_stall_due(now - g_xa2_t0)) != 0) {
+        if (g_wa)
+            bw_wa_stop();                /* Blood Wake (lat-a): the stream stops consuming */
+        else if (g_xa2_source)
+            IXAudio2SourceVoice_Stop(g_xa2_source, 0, XAUDIO2_COMMIT_NOW);
+        fprintf(stderr, "[XA2] test: the device stops taking sound at %llu ms, with no error and no"
+                " notice (BW_TEST_AUDIO_STALL)\n", (unsigned long long)t);
+    }
+    while ((t = test_newdefault_due(now - g_xa2_t0)) != 0) {
+        fprintf(stderr, "[XA2] test: Windows' default-device notice at %llu ms; the device stays"
+                " (BW_TEST_AUDIO_NEWDEFAULT)\n", (unsigned long long)t);
+        InterlockedCompareExchange(&g_xa2_lost, 2, 0);
+    }
+    if (g_xa2_rebuilt_at && now - g_xa2_rebuilt_at >= 1000 && xa2_have_voice()) {
+        uint64_t sp = xa2_voice_played();
+        fprintf(stderr, "[XA2] one second after the rebuild the new device has played %llu "
+                "samples (%.0f ms of sound)\n", (unsigned long long)sp, sp / 48.0);
+        g_xa2_rebuilt_at = 0;
+    }
+    if (g_rb_releasing) {
+        if (bw_out_poll(NULL, NULL))
+            g_rb_releasing = 0;
+        else if (g_xa2_lost || (g_xa2_waiting && now >= g_xa2_retry_at))
+            return;                      /* au-out: the worker is letting the old output go: next period */
+    }
+    if (g_rb_open) {
+        /* au-out: an open on the worker is under way: a newer change makes
+         * it open again; its result is swapped in here, at a period's start */
+        long rhr;
+        double rms;
+        why = InterlockedExchange(&g_xa2_lost, 0);
+        if (why) {
+            if (!(g_xa2_waiting && why == 2))
+                fprintf(stderr, "[XA2] the audio device is gone or changed: %s (while a device was being"
+                        " opened: the default one is opened again)\n", k_why[why < 6 ? why : 0]);
+            g_rb_again = 1;
+            if (why != 2 && g_rb_keep) {
+                if (xa2_have_voice())
+                    xa2_rb_drop_live(0); /* the old device died meanwhile (the worker is busy) */
+                g_rb_keep = 0;
+            }
+        }
+        if (bw_out_poll(&rhr, &rms))
+            xa2_rb_finish(rhr, rms);
+        return;
+    }
+    if (!g_xa2_lost && !(g_xa2_waiting && now >= g_xa2_retry_at))
+        return;
+    why = InterlockedExchange(&g_xa2_lost, 0);
+    if (why) {
+        const char *e = getenv("BW_AUDIO_REBUILD");
+        if (g_xa2_waiting && why == 2)
+            g_xa2_quiet_events++;        /* while no device: counted, said once when it's back */
+        else
+            fprintf(stderr, "[XA2] the audio device is gone or changed: %s\n", k_why[why < 6 ? why : 0]);
+        if (why == 1 || why == 5)
+            fprintf(stderr, "[XA2] (the error: 0x%08lX)\n", (unsigned long)g_xa2_lost_hr);
+        if (e && *e == '0') {
+            fprintf(stderr, "[XA2] no rebuild (BW_AUDIO_REBUILD=0): silent until the next boot\n");
+            return;
+        }
+    }
+    {
+        static int com;
+        if (!com++) {
+            HRESULT c = CoInitializeEx(NULL, COINIT_MULTITHREADED);   /* this thread's, once */
+            (void)c;
+        }
+    }
+    if (xa2_rb_worker() && xa2_rb_start(why, 1))
+        return;                          /* au-out: opened on the worker, swapped in later */
+    QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&q0);
+    g_xa2_played_base += xa2_voice_played();
+    /* lat-a: what the old voice still held is lost, never played; the new
+     * voice's stream starts where the played count stands */
+    g_xa2_submitted = g_xa2_played_base;
+    xa2_release();
+    hr = xa2_open(0, g_xa2_waiting);
+    if (FAILED(hr) && g_wa && hr != HRESULT_FROM_WIN32(ERROR_NOT_FOUND)
+            && hr != AUDCLNT_E_DEVICE_INVALIDATED) {
+        /* lat-a: a device is there but the stream won't open on it: the rest
+         * of this boot goes on with XAudio2 rather than waiting forever */
+        fprintf(stderr, "[XA2] the WASAPI output didn't reopen (0x%08lX): this boot goes on with"
+                " XAudio2\n", (unsigned long)hr);
+        xa2_release();
+        g_wa = 0;
+        hr = xa2_open(0, g_xa2_waiting);
+    }
+    g_st_played_last = g_xa2_played_base;   /* lat-a: no pass spans the rebuild */
+    g_ev_last = g_xa2_played_base;
+    g_xa2_next_buf = 0;
+    g_xa2_fill = 0;
+    g_xa2_dry = 1;                       /* the empty new voice is not an underrun */
+    if (FAILED(hr)) {
+        xa2_release();
+        QueryPerformanceCounter(&q1);
+        if (!g_xa2_waiting)
+            fprintf(stderr, "[XA2] no audio device (0x%08lX, %.1f ms to find out): the game runs "
+                    "silent and tries again when Windows has a device (or every 5 s)\n", hr,
+                    (double)(q1.QuadPart - q0.QuadPart) * 1000.0 / (double)f.QuadPart);
+        g_xa2_waiting = 1;
+        g_xa2_retry_at = now + 5000;     /* Windows' notice usually comes first */
+        return;
+    }
+    QueryPerformanceCounter(&q1);
+    if (g_xa2_quiet_events)
+        fprintf(stderr, "[XA2] (Windows changed its default device %u more times while there was "
+                "none)\n", g_xa2_quiet_events);
+    g_xa2_quiet_events = 0;
+    g_xa2_waiting = 0;
+    g_xa2_rebuilds++;
+    g_xa2_rebuilt_at = now;
+    fprintf(stderr, "[XA2] rebuilt on the default audio device in %.1f ms (rebuild %u; %s, as "
+            "the game was told at boot%s); sound goes on\n",
+            (double)(q1.QuadPart - q0.QuadPart) * 1000.0 / (double)f.QuadPart, g_xa2_rebuilds,
+            g_xa2_channels == 6 ? "5.1" : "stereo", g_wa ? "; WASAPI" : "");
+}
+
+/* 0.2.5 item 105 (carried apu_core.c calls it): each period while the device
+ * queue is stalled, when no submit runs xa2_check_device. A loss flagged
+ * meanwhile is acted on, and a device that has taken no sound for a second
+ * counts as lost (why 4), at most every 5 s. BW_AUDIO_REBUILD=0 keeps the old
+ * behaviour (silent until the next boot). Every edition, on either output. */
+void xa2_poll_stalled(int stalled_ms)
+{
+    static int no_rebuild = -1;
+    static ULONGLONG s_last;
+    ULONGLONG now = GetTickCount64();
