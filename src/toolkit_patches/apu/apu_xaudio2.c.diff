+
+/* Carried apu_core.c's pacing, event-driven, below the high mark: when to
+ * start the top-up (0: now). */
+int64_t xa2_topup_due(int64_t now_us)
+{
+    int64_t lead, n;
+    xa2_lead_us();
+    xa2_lead_check_short(now_us);          /* au-lat: BW_WASAPI_LEAD=auto */
+    lead = xa2_lead_us();
+    if (!lead || !bw_wa_event())
+        return 0;
+    n = xa2_next_pass(now_us);
+    return n && n - lead > now_us ? n - lead : 0;
+}
+
+/* Carried apu_core.c's throttle: wait for the engine's event or wait_us,
+ * whichever is first, on a high-resolution timer where Windows has one (else
+ * whole milliseconds). Returns 1 on the event; a wake on it after a real wait
+ * is a pass's time. */
+int xa2_wait(void *ev, int64_t wait_us)
+{
+    static HANDLE tm;
+    static int tried;
+    DWORD r;
+    int64_t t0 = xa2_now_us();
+    if (!tried) {
+        tried = 1;
+        tm = CreateWaitableTimerExW(NULL, NULL, 0x00000002 /* CREATE_WAITABLE_TIMER_HIGH_RESOLUTION */,
+                                    TIMER_ALL_ACCESS);
+    }
+    if (tm) {
+        HANDLE hs[2];
+        LARGE_INTEGER due;
+        hs[0] = (HANDLE)ev;
+        hs[1] = tm;
+        due.QuadPart = -(wait_us * 10);
+        SetWaitableTimer(tm, &due, 0, NULL, NULL, FALSE);
+        r = WaitForMultipleObjects(2, hs, FALSE, (DWORD)(wait_us / 1000 + 50));
+        if (r != WAIT_OBJECT_0 + 1)
+            CancelWaitableTimer(tm);
+    } else {
+        r = WaitForSingleObject((HANDLE)ev, (DWORD)((wait_us + 999) / 1000));
+    }
+    if (r == WAIT_OBJECT_0) {
+        int64_t t = xa2_now_us();
+        if (t - t0 >= 300) {
+            g_pass_us = t;                /* it waited, then the pass came */
+            xa2_grid_note(t);             /* au-orig: the spread's pass grid */
+        }
+        return 1;
+    }
+    return 0;
+}
+
+/* The critical write's slack (BW_XA2_STATS): pad was below a pass and this
+ * write makes it a whole one. */
+static void xa2_slack_note(int pad, int n)
+{
+    int p = bw_wa_period() > 0 ? bw_wa_period() : 480;
+    int64_t now, nx;
+    int b;
+    if (pad >= p || pad + n < p)
+        return;
+    now = xa2_now_us();
+    nx = xa2_next_pass(now);
+    if (g_bw_hot)
+        bw_hot_cw(pad, n, nx ? nx - now : -1);   /* au-hot: the pass's critical write */
+    if (g_spread_go) {
+        /* au-orig: the spread's making, from its point to the write */
+        if (now - g_spread_go < 50000)  /* a stall (no write for 50 ms) isn't a making */
+            xa2_spread_cost(now, now - g_spread_go);
+        g_spread_go = 0;
+    }
+    if (!nx)
+        return;
+    if (g_lead_auto) {
+        /* au-lat: the cost of this top-up, from when it could start (right
+         * after the pass, or the lead before the next one) */
+        int64_t pus = (int64_t)p * 1000000LL / XA2_SAMPLE_RATE;
+        int64_t cost = (g_lead_cur ? g_lead_cur : pus) - (nx - now);
+        xa2_lead_cost(now, cost < 0 ? 0 : cost, pus);
+    }
+    if (!g_xa2_stat_on)
+        return;
+    b = (int)((nx - now) / 250);
+    g_slack_h[b < 0 ? 0 : b >= XA2_SLACK_BINS ? XA2_SLACK_BINS - 1 : b]++;
+}
+
+static void xa2_slack_line(void)
+{
+    unsigned long tot = 0, c = 0;
+    int i, mn = -1, p1 = -1, med = -1;
+    for (i = 0; i < XA2_SLACK_BINS; i++)
+        tot += g_slack_h[i];
+    if (!tot)
+        return;
+    for (i = 0; i < XA2_SLACK_BINS; i++) {
+        if (!g_slack_h[i])
+            continue;
+        if (mn < 0)
+            mn = i;
+        c += g_slack_h[i];
+        if (p1 < 0 && c * 100 >= tot)
+            p1 = i;
+        if (c * 2 >= tot) {
+            med = i;
+            break;
+        }
+    }
+    fprintf(stderr, "; the write that completes a pass lands min %.2f p1 %.2f median %.2f ms before it (%lu)",
+            mn * 0.25, p1 * 0.25, med * 0.25, tot);
+    memset(g_slack_h, 0, sizeof g_slack_h);
+    if (g_lead_auto) {
+        /* au-lat: the auto lead */
+        fprintf(stderr, "; the lead %.2f ms (auto; %u changes; the worst top-up %.2f ms)", g_lead_cur / 1000.0,
+                g_lead_changes, g_lead_cost_worst_line / 1000.0);
+        g_lead_changes = 0;
+        g_lead_cost_worst_line = 0;
+    }
+    if (g_spread > 0) {
+        /* au-orig: the spread */
+        fprintf(stderr, "; the spread: %u periods at their point, %u at once; the room up to %.2f ms (the worst"
+                        " making %.2f ms)", g_sp_deferred, g_sp_now, g_sp_room_line / 1000.0,
+                g_sp_worst_line / 1000.0);
+        g_sp_deferred = g_sp_now = 0;
+        g_sp_worst_line = g_sp_room_line = 0;
+    }
+}
+
+/* Blood Wake (au-out, carried apu_core.c's adaptive queue): the WASAPI
+ * output's pacing marks in samples, from the engine's period P (480 frames
+ * at this PC's 10 ms; IAudioClient3's where smaller):
+ *   floor  P + a margin: event-driven, the stream is topped up to it right
+ *          after each pass, so the next pass finds a whole period and has
+ *          the pass's 10 ms to be made in: no margin (measured, 0 glitches
+ *          at P under load, docs/audio/out.md 5; BW_WASAPI_MARGIN, samples);
+ *          polled, 288 (lat-a's measured 768 at P = 480). BW_WASAPI_FLOOR
+ *          sets the floor itself.
+ *   start  1536 (32 ms, lat-a's start; BW_WASAPI_START), then two steps
+ *          down to the floor after 40 s with no short pass: a boot's
+ *          loading can stall the frame thread past one pass (seen: 55 ms
+ *          once, at Remastered's high frame rate), and real play reaches a
+ *          mission long after the 40 s.
+ *   cap    2688 (56 ms, lat-a's cap)
+ * each within the stream's buffer (less a period). Returns 0 on XAudio2, and
+ * with BW_WASAPI_MARKS=buffers or RECOMP_AUDIO_BUF_SAMPLES (lat-a's
+ * 384-sample units). */
+/* Blood Wake (au-fx, carried apu_core.c's adaptive queue): 1, once, after a
+ * WASAPI stream was put in place with no tail to carry (a lost device), so
+ * the queue starts again at its start mark (bw_apu_wasapi.c; 0 on XAudio2
+ * and with BW_WASAPI_REBUILD_START=0). */
+int xa2_queue_restart(void)
+{
+    return g_xa2_initialized && g_wa && bw_wa_take_queue_restart();
+}
+
+/* au-lat (docs/audio/lat.md 2.4): the event-driven floor stays one engine
+ * period (au-out's). A battle's moments of slow periods (RC2 has them too)
+ * leave the write that completes a pass at 0-0.25 ms before it in about 1
+ * battle in 3-10, and a 2-4 ms short pass in about 1 in 10. BW_WASAPI_MARGIN
+ * adds samples to the floor; 96 (2 ms) reduced but didn't remove them in its
+ * confirmation, and a margin is a price on every sound, so the cause (the
+ * frame thread's own work, not the lock) is for a lane of its own. */
+#define BW_WA_EVENT_MARGIN 0
+int xa2_marks_samples(int *floor, int *start, int *cap)
+{
+    static int mode = -1, last_p = 480, margin, margin_set, floor_set = -1, start_set = -1, ev = 1;
+    const char *e;
+    int p, fl, st, c, lim;
+    if (!g_xa2_initialized || !g_wa)
+        return 0;
+    if (mode < 0) {                      /* read once */
+        e = getenv("BW_WASAPI_MARKS");
+        mode = !(e && e[0] == 'b') && !getenv("RECOMP_AUDIO_BUF_SAMPLES");
+        e = getenv("BW_WASAPI_EVENT");
+        ev = !(e && *e == '0');
+        margin = ev ? BW_WA_EVENT_MARGIN : 288;
+        e = getenv("BW_WASAPI_MARGIN");
+        if (e && *e)
+            margin = atoi(e), margin_set = 1;
+        e = getenv("BW_WASAPI_FLOOR");
+        if (e && *e)
+            floor_set = atoi(e);
+        e = getenv("BW_WASAPI_START");
+        if (e && *e)
+            start_set = atoi(e);
+    }
+    if (!mode)
+        return 0;
+    p = bw_wa_period();
+    if (p > 0)
+        last_p = p;                      /* no stream: the last one's */
+    p = last_p;
+    /* au-lat: exclusive mode (a test switch): the device wants a whole period
+     * every 3 ms or so, so the ring keeps one APU period more than that */
+    fl = floor_set >= 0 ? floor_set : p + (!margin_set && bw_wa_exclusive() ? 256 : margin);
+    st = start_set >= 0 ? start_set : 1536;
+    if (st < fl)
+        st = fl;
+    c = 2688;
+    if (c < st)
+        c = st;
+    lim = bw_wa_capacity() - 256;
+    if (bw_wa_active() && lim > 0) {
+        if (c > lim)
+            c = lim;
+        if (st > c)
+            st = c;
+        if (fl > st)
+            fl = st;
+    }
+    if (fl < 1)
+        fl = 1;
+    *floor = fl;
+    *start = st;
+    *cap = c;
+    return 1;
 }
 
 #else /* !_WIN32: apu_sdl2.c implements the same contract over SDL2 */
