+/* Blood Wake carried patch (item 76): the player's bindings, and the ramp and
+ * strength of the steering keys. Written once at start-up, before the game's
+ * first poll; read by the poll only. */
+static InputBindings s_bw_bindings;
+static volatile int  s_bw_configured;
+static int           s_bw_ramp_ms, s_bw_strength = 100;
+
+void xbox_InputKeyboardConfigure(const struct InputBindings *b, int ramp_ms, int strength_pct)
+{
+    if (ramp_ms < 0) ramp_ms = 0;
+    if (ramp_ms > 2000) ramp_ms = 2000;
+    if (strength_pct < 10) strength_pct = 10;
+    if (strength_pct > 100) strength_pct = 100;
+    s_bw_configured = 0;
+    if (b)
+        s_bw_bindings = *b;
+    s_bw_ramp_ms = ramp_ms;
+    s_bw_strength = strength_pct;
+    s_bw_configured = b ? 1 : 0;
+}
+
+#if defined(_WIN32)
+#include <windows.h>
+static double bw_now_ms(void)
+{
+    static LARGE_INTEGER f;
+    LARGE_INTEGER t;
+    if (!f.QuadPart)
+        QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&t);
+    return (double)t.QuadPart * 1000.0 / (double)f.QuadPart;
+}
+#else
+#include <time.h>
+static double bw_now_ms(void)
+{
+    struct timespec ts;
+    timespec_get(&ts, TIME_UTC);
+    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+#endif
+
+/* The steering keys (left stick left/right) after the strength and the ramp.
+ * `target` is what the keys say now (full turn, or 0). Releasing, or turning
+ * the other way, starts again from the centre at once; a held key then moves
+ * the stick towards its turn at full-turn-per-ramp_ms. */
+static SHORT bw_steer(SHORT target)
+{
+    static double value, last;
+    double now = bw_now_ms(), dt = last > 0.0 ? now - last : 0.0, t;
+    last = now;
+    t = (double)target * s_bw_strength / 100.0;
+    if (s_bw_ramp_ms <= 0 || t == 0.0 || (t > 0.0) != (value > 0.0))
+        value = s_bw_ramp_ms <= 0 ? t : 0.0;
+    if (s_bw_ramp_ms > 0 && t != 0.0) {
+        double step = 32767.0 * (dt > 100.0 ? 100.0 : dt) / s_bw_ramp_ms;
+        if (t > 0.0)
+            value = value + step > t ? t : value + step;
+        else
+            value = value - step < t ? t : value - step;
+    }
+    return (SHORT)(value >= 0.0 ? value + 0.5 : value - 0.5);
+}
