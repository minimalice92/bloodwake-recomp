+            s_vbl_mult == 1001000000ull ? "59.94 Hz, NTSC (BW_VBLANK_HZ=60 for exactly 60)"
+                                        : (s_vbl_div == 50 ? "50 Hz (BW_VBLANK_HZ=50)"
+                                                           : "exactly 60 Hz (BW_VBLANK_HZ=60)"),
+            (double)s_vbl_mult / (double)s_vbl_div / 1000.0);
