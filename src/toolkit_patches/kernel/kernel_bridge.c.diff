+{
+    const char *e;
+    if (s_vbl_mult)
+        return;
+    e = getenv("BW_VBLANK_HZ");
+    if (e && !strcmp(e, "60")) {
+        s_vbl_mult = 1000000000ull; s_vbl_div = 60;
+    } else if (e && !strcmp(e, "50")) {
+        s_vbl_mult = 1000000000ull; s_vbl_div = 50;
+    } else {
+        s_vbl_mult = 1001000000ull; s_vbl_div = 60;     /* NTSC 59.94 Hz */
+    }
