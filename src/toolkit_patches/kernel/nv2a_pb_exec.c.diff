+/* DOT_RGBMAPPING: an earlier stage's colour as a vector (xemu psh.c sign1/2/3).
+ * 0 zero-to-one, 1 -1..1 D3D, 2 -1..1 GL, 3 -1..1 signed; the HILO modes
+ * (4-7) need 16-bit texels and read as 0..1 here. */
+static void dot_map(const float c[4], uint32_t m, float v[3])
+{
+    int i;
+    for (i = 0; i < 3; i++) {
+        float x = c[i] * 255.0f;
+        switch (m) {
+        case 1: v[i] = (x - 128.0f) / 127.0f; break;
+        case 2: v[i] = x >= 128.0f ? (x - 255.5f) / 127.5f : (x + 0.5f) / 127.5f; break;
+        case 3: v[i] = x >= 128.0f ? (x - 256.0f) / 127.0f : x / 127.0f; break;
+        default: v[i] = c[i]; break;
+        }
+    }
+}
