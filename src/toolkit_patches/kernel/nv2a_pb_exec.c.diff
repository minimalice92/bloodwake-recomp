+static void bw_draw_points(uint32_t n)
+{
+    int sprite = s_reg[0x031C / 4] != 0;
+    int front_cw = s_reg[0x03A0 / 4] != 0x901;
+    int cull = s_reg[0x0308 / 4] != 0;
+    uint32_t face = s_reg[0x039C / 4];
+    int cw;
+    uint32_t i, k;
+    if (cull && face == 0x408)
+        return;                                     /* both faces culled */
+    /* Clockwise on the surface (y down) is front when FRONT_FACE is CW. */
+    cw = front_cw ^ (cull && face == 0x404);
+    for (i = 0; i < n; i++) {
+        const Nv2aVshOutput *v = &s_xf[i];
+        Nv2aVshOutput q[4];
+        float hx = s_bw_pts[i] * 0.5f * aa_scale_x(), hy = s_bw_pts[i] * 0.5f * aa_scale_y();
+        if (!(v->pos[3] > 0.0f))
+            continue;                               /* behind the eye */
+        for (k = 0; k < 4; k++) {                   /* TL, TR, BL, BR */
+            q[k] = *v;
+            q[k].pos[0] += (k & 1) ? hx : -hx;
+            q[k].pos[1] += (k & 2) ? hy : -hy;
+            if (sprite) {
+                q[k].tex[3][0] = (k & 1) ? 1.0f : 0.0f;
+                q[k].tex[3][1] = (k & 2) ? 1.0f : 0.0f;
+                q[k].tex[3][2] = 1.0f;
+                q[k].tex[3][3] = 1.0f;
+            }
+        }
+        if (cw) {
+            raster_xf_clipped(&q[0], &q[1], &q[2]);
+            raster_xf_clipped(&q[1], &q[3], &q[2]);
+        } else {
+            raster_xf_clipped(&q[0], &q[2], &q[1]);
+            raster_xf_clipped(&q[1], &q[2], &q[3]);
+        }
+    }
+}
