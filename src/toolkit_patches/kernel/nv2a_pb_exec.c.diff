+ * over as one level: no mipmaps on the GPU path. BW_GPU_STALEPITCH=1 restores
+ * the old test for comparison. */
+static uint32_t tex_levels_for_backend(const Texture *t)
+{
+    static int stale = -1;
+    if (stale < 0) {
