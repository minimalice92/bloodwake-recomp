+ * and per logical pixel (x slopes measured on the 2x-wide anti-aliased
+ * surface are doubled). Only filled polygons are drawn, so the point and line
+ * enables never apply. BW_GPU_POLYOFFSET=0 turns it off (as before). */
+static int bw_poly_offset_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("BW_GPU_POLYOFFSET");
+        on = !(e && e[0] == '0');
+    }
+    return on && s_reg[0x0338 / 4] && !bw_ab_off("polyoffset");
+}
