+/* Blood Wake carried patch: the fixed-function fog coordinate, which
+ * ffp_vertex never produced, so every fixed-function vertex read fog
+ * distance 0 -- with Blood Wake's linear fog (params 2.3077, -0.00154) that
+ * is a fog factor of 1, no fog at all, while the vertex-program draws around
+ * them fade into the haze. Mission draws with fog on and FOG_GEN_MODE 2
+ * (planar): about 6% of draws (BW_GPU_AUDIT, 2026-10-27). As xemu vsh-ff.c,
+ * from SET_FOG_GEN_MODE (0x02A0), with the eye-space position (model-view 0,
+ * the layout lit_color uses): 0 the specular alpha (the attribute; this
+ * path computes no specular), 1 radial |eye|, 2 planar dot(c[57].xyz, eye) +
+ * c[57].w, 3 its absolute value, 6 the fog coordinate attribute (v5.x).
+ * BW_GPU_FFPFOG=0 restores the old distance 0. */
+static float ffp_fog_distance(uint32_t index, const float pos[4])
+{
+    static int on = -1;
+    const float *mv = (const float *)&s_reg[0x0480 / 4], *fp = nv2a_vsh_constant(57);
+    uint32_t gen = s_reg[0x02A0 / 4];
+    float e[3], v[4], d;
+    int i;
+    if (on < 0) {
+        const char *env = getenv("BW_GPU_FFPFOG");
+        on = !(env && env[0] == '0');
+    }
+    if (!on || !s_gpu.fog_enable || bw_ab_off("ffpfog"))
+        return 0.0f;
+    if (gen == 0) {                              /* SPEC_ALPHA */
+        if (!(s_gpu.attr[4].size ? fetch_attr(&s_gpu.attr[4], index, v) : 0))
+            memcpy(v, s_gpu.imm_attr[4], sizeof v);
+        return v[3] < 0.0f ? 0.0f : v[3] > 1.0f ? 1.0f : v[3];
+    }
+    if (gen == 6) {                              /* FOG_X */
+        if (!(s_gpu.attr[5].size ? fetch_attr(&s_gpu.attr[5], index, v) : 0))
+            memcpy(v, s_gpu.imm_attr[5], sizeof v);
+        return v[0];
+    }
+    for (i = 0; i < 3; i++)
+        e[i] = mv[4 * i] * pos[0] + mv[4 * i + 1] * pos[1]
+             + mv[4 * i + 2] * pos[2] + mv[4 * i + 3] * pos[3];
+    if (gen == 1)                                /* RADIAL */
+        return sqrtf(e[0] * e[0] + e[1] * e[1] + e[2] * e[2]);
+    d = fp[0] * e[0] + fp[1] * e[1] + fp[2] * e[2] + fp[3];
+    return gen == 3 ? fabsf(d) : d;              /* PLANAR, ABS_PLANAR */
+}
