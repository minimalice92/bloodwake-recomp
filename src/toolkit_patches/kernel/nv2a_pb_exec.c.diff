+            what = "z";
+        else if (!bw_vclose(o->fog, fog_factor(c.fog[0]), 1e-3f, 1e-3f)) what = "fog";
+        else if (!bw_vclose(o->clip[0], cd0, 1e-4f, 1e-4f)) what = "clip w";
+        else if (!bw_vclose(o->clip[1], cd1, 1e-2f, 1e-3f)) what = "clip near";
+        for (k = 0; k < 4 && !what; k++) {
+            if (!bw_vclose(o->d0[k], c.d0[k], 1e-3f, 1e-3f)) what = "d0";
+            else if (!bw_vclose(o->d1[k], c.d1[k], 1e-3f, 1e-3f)) what = "d1";
+            for (j = 0; j < 4 && !what; j++)
+                if (!bw_vclose(o->tc[k][j], c.tex[k][j], 1e-3f, 1e-3f)) what = "tex";
+        }
+        if (!what)
+            continue;
+        bad_verts++;
+        bad = 1;
+        /* A finite vertex that differs is a translation bug, not overflow:
+         * print the program and this vertex's inputs, once. */
+        if (dumped < 2 && isfinite(c.pos[0]) && isfinite(c.pos[1]) && isfinite(c.pos[2])
+            && fabsf(c.pos[3]) < 1e20f) {
+            uint32_t q, a;
+            dumped++;
+            fprintf(stderr, "[VSH-VERIFY] program (%u instructions from slot %u, inputs %04X):\n",
+                    nins, s_bw_start, mask);
+            for (q = 0; q < nins; q++)
+                fprintf(stderr, "[VSH-VERIFY]   %3u %08X %08X %08X %08X\n", q,
+                        s_bw_prog[s_bw_start + q][0], s_bw_prog[s_bw_start + q][1],
+                        s_bw_prog[s_bw_start + q][2], s_bw_prog[s_bw_start + q][3]);
+            for (a = 0; a < NV2A_VSH_INPUTS; a++) {
+                float in[4];
+                if (!(mask & (1u << a)))
+                    continue;
+                if (!s_gpu.attr[a].size)
+                    memcpy(in, s_gpu.imm_attr[a], sizeof in);
+                else
+                    fetch_attr(&s_gpu.attr[a], s_bw_uidx[l], in);
+                fprintf(stderr, "[VSH-VERIFY]   v%u = %g %g %g %g\n", a, in[0], in[1], in[2], in[3]);
+            }
+            for (a = 0; a < 192; a++) {
+                const float *kc = nv2a_vsh_constant(a);
+                if (kc[0] != 0.0f || kc[1] != 0.0f || kc[2] != 0.0f || kc[3] != 0.0f)
+                    fprintf(stderr, "[VSH-VERIFY]   c[%u] = %g %g %g %g\n", a, kc[0], kc[1], kc[2], kc[3]);
+            }
+        }
+        if (shown++ < 24) {
+            fprintf(stderr, "[VSH-VERIFY] batch %u vertex %u (index %u) differs in %s:\n"
+                    "  gpu pos %g %g %g %g fog %g d0 %g %g %g %g tc0 %g %g %g %g\n"
+                    "  cpu pos %g %g %g %g fog %g d0 %g %g %g %g tc0 %g %g %g %g\n",
+                    s_gpu.batches_program, l, s_bw_uidx[l], what,
+                    o->pos[0], o->pos[1], o->pos[2], o->pos[3], o->fog,
+                    o->d0[0], o->d0[1], o->d0[2], o->d0[3],
+                    o->tc[0][0], o->tc[0][1], o->tc[0][2], o->tc[0][3],
+                    c.pos[0], c.pos[1], c.pos[2], c.pos[3], fog_factor(c.fog[0]),
+                    c.d0[0], c.d0[1], c.d0[2], c.d0[3],
+                    c.tex[0][0], c.tex[0][1], c.tex[0][2], c.tex[0][3]);
+        }
+    }
+    bad_batches += bad;
+    if (checked % 100 == 0)
+        fprintf(stderr, "[VSH-VERIFY] %u batches checked, %u differ; %llu vertices, %llu differ,"
+                        " %llu skipped (odd inputs)\n",
+                checked, bad_batches, verts, bad_verts, odd_verts);
+}
+
+/* Blood Wake carried patch (P1): GPU-side vertex fetch. The gather in
+ * gpu_vsh_batch (fetch_attr per attribute per distinct vertex, floats out)
+ * and its loop were the NV2A thread's largest costs, 24% of it once the game
+ * thread runs ahead (profile -124052-p1a15prof). Instead, each vertex
+ * stream's span over the batch's index range goes to the back end as the
+ * title's own bytes, and its input layout and shader prologue convert the
+ * formats exactly as fetch_attr does (bw_backend_ext.h). Anything else -- a
+ * type or size fetch_attr reads differently, an unaligned stride or offset,
+ * a span outside guest memory, a sparse index range, a back end reading the
+ * floats itself -- takes the gather as before. BW_GPU_VFETCH=0 turns it off. */
+static int bw_vfetch_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("BW_GPU_VFETCH");
+        on = !(e && e[0] == '0');
+        fprintf(stderr, "[GPU] vertex fetch on the GPU %s (BW_GPU_VFETCH)\n", on ? "on" : "off");
+    }
+    return on;
+}
+
+/* The conversion for attribute `at` and the bytes one element spans as the
+ * back end reads it (a 3-component byte or short format reads 4); 0 if
+ * fetch_attr's reading has no exact twin there. */
+static uint8_t bw_vfetch_conv(const VertexAttr *at, uint32_t *fbytes)
+{
+    uint32_t s = at->size;
+
+    if (s < 1 || s > 4)
+        return 0;
+    switch (at->type) {
+    case 2: *fbytes = 4u * s;                return (uint8_t)(BW_XVS_FLOAT << 4 | s);
+    case 0: *fbytes = 4;                     return (uint8_t)(BW_XVS_COLOR << 4 | 4);
+    case 4: *fbytes = s == 3 ? 4u : s;       return (uint8_t)(BW_XVS_UBYTE << 4 | s);
+    case 5: *fbytes = s == 3 ? 8u : 2u * s;  return (uint8_t)(BW_XVS_SHORT << 4 | s);
+    case 6: if (s != 1) return 0;
+            *fbytes = 4;                     return (uint8_t)(BW_XVS_CMP << 4 | 1);
+    default: return 0;                       /* 1 (normalised short) and the rest: gathered */
+    }
+}
+
+static unsigned long long s_bw_vf_raw, s_bw_vf_gather;     /* batches each way, for the report */
+
+/* Fill vb's streams for the n indices in s_gpu.idx and the inputs in mask.
+ * Returns 1 with *first (the lowest index) and *count (the span's vertices). */
+static int bw_vfetch_build(BwXVsBatch *vb, uint32_t n, uint32_t mask,
+                           uint32_t *first, uint32_t *count)
+{
+    static const uint8_t *s_mem0;
+    uint32_t lo = 0xFFFFFFFFu, hi = 0, i, a, s, k = 0, ns = 0;
+    uint32_t sbase[BW_XVS_MAX_STREAMS], send[BW_XVS_MAX_STREAMS], sstride[BW_XVS_MAX_STREAMS];
+    uint32_t aoff[16];
+    const uint8_t *mem;
+    uint64_t total = 0;
+
+    if (!bw_vfetch_on() || !s_xbackend->vsh_raw_ok || !s_xbackend->vsh_raw_ok() || !n)
+        return 0;
+    for (i = 0; i < n; i++) {
+        uint32_t v = s_gpu.idx[i];
+        if (v < lo) lo = v;
+        if (v > hi) hi = v;
+    }
+    /* a sparse range would copy more than the gather converts */
+    if (hi - lo >= NV_MAX_INDICES || hi - lo + 1 > 2u * n + 64u)
+        return 0;
+    mem = s_mem0 ? s_mem0 : (s_mem0 = (const uint8_t *)xbox_GetMemoryOffset());
+    for (a = 0; a < NV2A_VSH_INPUTS; a++) {
+        const VertexAttr *at = &s_gpu.attr[a];
+        uint32_t fb = 0;
+        uint8_t conv;
+
+        if (!(mask & (1u << a)))
+            continue;
+        if (!at->size) {                     /* no array: the current value, as the gather */
+            if (ns == BW_XVS_MAX_STREAMS)
+                return 0;
+            vb->streams[ns].data = s_gpu.imm_attr[a];
+            vb->streams[ns].bytes = 16;
+            vb->streams[ns].stride = 0;
+            vb->in[k].stream = (uint8_t)ns;
+            vb->in[k].conv = (uint8_t)(BW_XVS_CONST << 4 | 4);
+            vb->in[k].offset = 0;
+            aoff[k] = 0;
+            sbase[ns] = send[ns] = 0;
+            sstride[ns] = 0;
+            ns++;
+            k++;
+            continue;
+        }
+        if (!at->stride || (at->stride & 3u) || at->stride > 2048u || (at->offset & 3u))
+            return 0;
+        if (!s_gpu.inline_active && !at->offset)
+            return 0;                        /* fetch_attr reads 0,0,0,1 there */
+        if (!(conv = bw_vfetch_conv(at, &fb)))
+            return 0;
+        {
+            /* BW_GPU_VFETCH_SKIP=<mask> (diagnostic): batches with an input
+             * of kind k (bit k, BW_XVS_*) take the gather */
+            static int skip = -1;
+            if (skip < 0) {
+                const char *e = getenv("BW_GPU_VFETCH_SKIP");
+                skip = e ? (int)strtol(e, NULL, 0) : 0;
+            }
+            if (skip & (1 << (conv >> 4)))
+                return 0;
+        }
+        /* interleaved attributes share a stream: one span, one copy */
+        for (s = 0; s < ns; s++) {
+            uint32_t b0, e0;
+            if (sstride[s] != at->stride)
+                continue;
+            b0 = at->offset < sbase[s] ? at->offset : sbase[s];
+            e0 = at->offset + fb > send[s] ? at->offset + fb : send[s];
+            if (e0 - b0 <= at->stride) {
+                sbase[s] = b0;
+                send[s] = e0;
+                break;
+            }
+        }
+        if (s == ns) {
+            if (ns == BW_XVS_MAX_STREAMS)
+                return 0;
+            sbase[ns] = at->offset;
+            send[ns] = at->offset + fb;
+            sstride[ns] = at->stride;
+            ns++;
+        }
+        vb->in[k].stream = (uint8_t)s;
+        vb->in[k].conv = conv;
+        aoff[k] = at->offset;
+        k++;
+    }
+    if (!k)
+        return 0;                            /* no inputs: nothing to fetch */
+    for (i = 0; i < k; i++)
+        if (sstride[vb->in[i].stream])
+            vb->in[i].offset = (uint16_t)(aoff[i] - sbase[vb->in[i].stream]);
+    for (s = 0; s < ns; s++) {
+        uint64_t at, bytes;
+        if (!sstride[s])
+            continue;
+        at = (uint64_t)sbase[s] + (uint64_t)lo * sstride[s];
+        bytes = (uint64_t)(hi - lo) * sstride[s] + (send[s] - sbase[s]);
+        if (s_gpu.inline_active) {
+            if (at + bytes > (uint64_t)s_gpu.inline_count * 4u)
+                return 0;
+            vb->streams[s].data = (const uint8_t *)s_gpu.inline_buf + at;
+        } else {
+            if (!guest_span_ok(at, (uint32_t)bytes))
+                return 0;
+            vb->streams[s].data = mem + at;
+        }
+        vb->streams[s].bytes = (uint32_t)bytes;
+        vb->streams[s].stride = sstride[s];
+        total += bytes;
+    }
+    if (total > (8u << 20))
+        return 0;
+    {
+        /* BW_GPU_VFETCH_LOG=<n> (diagnostic): the first n raw batches */
+        static int left = -1;
+        if (left < 0) {
+            const char *e = getenv("BW_GPU_VFETCH_LOG");
+            left = e ? atoi(e) : 0;
+        }
+        if (left > 0) {
+            left--;
+            fprintf(stderr, "[VFETCH] n %u range %u..%u inline %d mask %04X:", n, lo, hi,
+                    (int)s_gpu.inline_active, mask);
+            for (i = 0; i < k; i++)
+                fprintf(stderr, " [s%u conv %02X off %u]", vb->in[i].stream, vb->in[i].conv,
+                        vb->in[i].offset);
+            for (s = 0; s < ns; s++)
+                fprintf(stderr, " {s%u stride %u bytes %u}", s, sstride[s], vb->streams[s].bytes);
+            fputc(10, stderr);
+        }
+    }
+    vb->nstreams = ns;
+    *first = lo;
+    *count = hi - lo + 1;
+    return 1;
+}
+
+static int bw_gpu_vsh_verify_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("BW_GPU_VSH_VERIFY");
+        on = e && atoi(e) > 0;
+    }
+    return on;
+}
+
+static int gpu_vsh_batch(void)
+{
+    static int near_z = -1, no_rc = -1;
+    uint32_t n = s_gpu.idx_count, i, a, s, nins, mask, nin = 0, nv = 0, ni = 0;
+    uint32_t vfirst = 0;
+    int raw;
+    Nv2aSurface surf;
+    Nv2aRenderState rs;
+    BwXVsBatch vb;
+
+    if (!s_xbackend || !s_xbackend->draw_vsh || !backend_draws()
+        || !batch_uses_program() || s_bw_cxt_write)
+        return 0;
+    if (no_rc < 0)
+        no_rc = getenv("RECOMP_NO_COMBINERS") != NULL;
+    if (!s_gpu.rc_seen || no_rc)
+        return 0;
+    if (surface_bpp() != 4 && surface_bpp() != 2)
+        return 0;
+    for (s = s_bw_start; s < NV2A_VSH_SLOTS; s++)
+        if (s_bw_prog[s][3] & 1)                 /* FINAL */
+            break;
+    if (s >= NV2A_VSH_SLOTS)
+        return 0;                                /* no program: the CPU path skips it too */
+    nins = s - s_bw_start + 1;
+    mask = bw_vsh_inputs_used((const uint32_t (*)[4])s_bw_prog[s_bw_start], nins);
+    for (a = 0; a < NV2A_VSH_INPUTS; a++)
+        nin += (mask >> a) & 1;
+
+    if (!s_bw_map) {
+        s_bw_map = (uint32_t *)malloc(NV_MAX_INDICES * sizeof *s_bw_map);
+        s_bw_tri = (uint32_t *)malloc(NV_MAX_INDICES * 3 * sizeof *s_bw_tri);
+        s_bw_uidx = (uint32_t *)malloc(NV_MAX_INDICES * sizeof *s_bw_uidx);
+        if (!s_bw_map || !s_bw_tri || !s_bw_uidx)
+            return 0;
+    }
+    memset(&vb, 0, sizeof vb);
+    raw = bw_vfetch_build(&vb, n, mask, &vfirst, &nv);
+    if (raw) {
+        /* P1: the vertices are the span; the triangles index it directly. */
+        for (i = 0; i < n; i++)
+            s_bw_map[i] = s_gpu.idx[i] - vfirst;
+        s_bw_vf_raw++;
+        if (bw_gpu_vsh_verify_on()) {
+            /* the check compares every vertex of the span, and its odd-input
+             * test reads the gathered floats: gather them, for the check only */
+            if ((size_t)nv * nin * 4 > s_bw_vin_cap) {
+                size_t want = (size_t)nv * nin * 4;
+                float *p = (float *)realloc(s_bw_vin, want * sizeof *p);
+                if (!p)
+                    return 0;
+                s_bw_vin = p;
+                s_bw_vin_cap = want;
+            }
+            for (i = 0; i < nv; i++) {
+                float *dst = s_bw_vin + (size_t)i * nin * 4;
+                s_bw_uidx[i] = vfirst + i;
+                for (a = 0; a < NV2A_VSH_INPUTS; a++) {
+                    if (!(mask & (1u << a)))
+                        continue;
+                    if (!s_gpu.attr[a].size)
+                        memcpy(dst, s_gpu.imm_attr[a], 4 * sizeof *dst);
+                    else
+                        fetch_attr(&s_gpu.attr[a], vfirst + i, dst);
+                    dst += 4;
+                }
+            }
+        }
+        goto bw_tris;
+    }
+    vb.nstreams = 0;
+    s_bw_vf_gather++;
+    if ((size_t)n * nin * 4 > s_bw_vin_cap) {
+        size_t want = (size_t)n * nin * 4;
+        float *p = (float *)realloc(s_bw_vin, want * sizeof *p);
+        if (!p)
+            return 0;
+        s_bw_vin = p;
+        s_bw_vin_cap = want;
+    }
+    if (++s_bw_vbatch == 0) {
+        memset(s_bw_vstamp, 0, sizeof s_bw_vstamp);
+        s_bw_vbatch = 1;
+    }
+    for (i = 0; i < n; i++) {
+        uint32_t idx = s_gpu.idx[i], l;
+        if (idx < BW_VCACHE_N && s_bw_vstamp[idx] == s_bw_vbatch) {
+            s_bw_map[i] = s_bw_vslot[idx];
+            continue;
+        }
+        l = nv++;
+        s_bw_uidx[l] = idx;
+        {
+            float *dst = s_bw_vin + (size_t)l * nin * 4;
+            for (a = 0; a < NV2A_VSH_INPUTS; a++) {
+                if (!(mask & (1u << a)))
+                    continue;
+                /* As transform_vertex: no array reads the current value. */
+                if (!s_gpu.attr[a].size)
+                    memcpy(dst, s_gpu.imm_attr[a], 4 * sizeof *dst);
+                else
+                    fetch_attr(&s_gpu.attr[a], idx, dst);
+                dst += 4;
+            }
+        }
+        if (idx < BW_VCACHE_N) {
+            s_bw_vstamp[idx] = s_bw_vbatch;
+            s_bw_vslot[idx] = l;
+        }
+        s_bw_map[i] = l;
+    }
+
+bw_tris:
+#define BW_TRI(p, q, r) do { s_bw_tri[ni++] = s_bw_map[p]; s_bw_tri[ni++] = s_bw_map[q]; \
+                             s_bw_tri[ni++] = s_bw_map[r]; } while (0)
+    switch (s_gpu.prim) {
+    case NV_PRIM_TRIANGLES:
+        for (i = 0; i + 2 < n; i += 3)
+            BW_TRI(i, i + 1, i + 2);
+        break;
+    case NV_PRIM_TRIANGLE_STRIP:                 /* one winding: see below */
+        for (i = 0; i + 2 < n; i++) {
+            if (i & 1)
+                BW_TRI(i + 1, i, i + 2);
+            else
+                BW_TRI(i, i + 1, i + 2);
+        }
+        break;
+    case NV_PRIM_TRIANGLE_FAN:
+    case NV_PRIM_POLYGON:
+        for (i = 1; i + 1 < n; i++)
+            BW_TRI(0, i, i + 1);
+        break;
+    case NV_PRIM_QUADS:
+        for (i = 0; i + 3 < n; i += 4) {
+            BW_TRI(i, i + 1, i + 2);
+            BW_TRI(i, i + 2, i + 3);
+        }
+        break;
+    case NV_PRIM_QUAD_STRIP:
+        for (i = 0; i + 3 < n; i += 2) {
+            BW_TRI(i, i + 1, i + 3);
+            BW_TRI(i, i + 3, i + 2);
+        }
+        break;
+    default:
+        break;
+    }
+#undef BW_TRI
+    if (!ni)
+        return 0;
+
+    if (near_z < 0) {
+        const char *e = getenv("RECOMP_CLIP_NEAR_Z");
+        near_z = !(e && e[0] == '0');
+    }
+    current_surface(&surf);
+    current_render_state(&rs);
+    fill_xbatch(&vb.xb, &rs);                    /* vb was cleared above (P1's streams) */
+    vb.program = (const uint32_t (*)[4])s_bw_prog[s_bw_start];
+    vb.ninstr = nins;
+    vb.consts = (const float (*)[4])nv2a_vsh_constant(0);   /* c[0..191], contiguous */
+    {
+        extern uint32_t nv2a_vsh_constants_gen(void);         /* P1, carried interpreter */
+        vb.consts_gen = nv2a_vsh_constants_gen();
+    }
+    vb.inputs = raw ? NULL : s_bw_vin;
+    vb.input_mask = mask;
+    vb.ninputs = nin;
+    vb.nverts = nv;
+    vb.indices = s_bw_tri;
+    vb.nindices = ni;
+    vb.aa[0] = s_gpu.aa_sx;
+    vb.aa[1] = s_gpu.aa_sy;
+    vb.near_clip = near_z;
+    vb.fog_enable = s_gpu.fog_enable;
+    vb.fog_mode = s_gpu.fog_mode;
+    vb.fog_param[0] = s_gpu.fog_param[0];
+    vb.fog_param[1] = s_gpu.fog_param[1];
+    if (!s_xbackend->draw_vsh(&surf, &vb))
+        return 0;
+    gpu_vsh_verify(nv, nins, mask);
+
+    xf_set_viewport();
+    s_gpu.batches_program++;
+    s_gpu.verts_program += n;
+    note_blend_pair();
+    note_xf_formats();
+    s_gpu.tris_drawn += ni / 3;
+    note_drawn();
+    return 1;
+}
+
+/* Blood Wake carried patch: points, drawn as the NV2A draws them. Every point
+ * batch was dropped by both renderers: in a 39-scene sweep (BW_GPU_AUDIT,
+ * 2026-10-27) 28,370 point batches, 3.9 million points in 29 scenes, all with
+ * SET_POINT_SMOOTH_ENABLE (on the NV2A, point-sprite mode) and point params
+ * on, their size from the vertex program's oPts and their texture on stage 3
+ * (20,505 of them single points). Each point becomes a screen-aligned quad,
+ * as xemu's GL points: the size is oPts.x with point params on (vertex
+ * programs; the fixed-function attenuation formula otherwise, as vsh-ff.c),
+ * else SET_POINT_SIZE / 8; at least 1 and at most 63.875 pixels (the
+ * register's range); in logical pixels, so a sprite stays square on the 2x-wide
+ * anti-aliased surface (xemu sizes it in surface pixels). In sprite mode stage
+ * 3's coordinates run (0,0) top-left to (1,1) bottom-right (gl_PointCoord),
+ * the other stages keep the vertex's. Points are never culled, so the quad
+ * is wound to face the way the cull state keeps. BW_GPU_POINTS=0 drops points
+ * again, as before. */
+static float s_bw_pts[NV_MAX_INDICES];
+extern float bw_vsh_last_point_size(void);
+
+static int bw_points_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("BW_GPU_POINTS");
+        on = !(e && e[0] == '0');
+    }
+    return on && !bw_ab_off("points");
+}
+
+/* Right after transform_vertex(index): the size of that point in pixels. */
+static float bw_point_size(uint32_t index)
+{
+    const float *pp = (const float *)&s_reg[0x0A30 / 4];   /* SET_POINT_PARAMS */
+    float sz;
+    if (!s_reg[0x0318 / 4]) {                               /* point params off */
+        sz = (float)s_reg[0x043C / 4] / 8.0f;               /* SET_POINT_SIZE */
+    } else if (batch_uses_program()) {
+        sz = bw_vsh_last_point_size();
+    } else {
+        const float *mv = (const float *)&s_reg[0x0480 / 4];
+        float p[4], e[3], d, mn, mx, att;
+        int k;
+        if (!fetch_attr(&s_gpu.attr[0], index, p))
+            return 1.0f;
+        for (k = 0; k < 3; k++)
+            e[k] = mv[4 * k] * p[0] + mv[4 * k + 1] * p[1] + mv[4 * k + 2] * p[2] + mv[4 * k + 3] * p[3];
+        d = sqrtf(e[0] * e[0] + e[1] * e[1] + e[2] * e[2]);
+        att = pp[0] + pp[1] * d + pp[2] * d * d;
+        sz = (att > 0.0f ? 1.0f / sqrtf(att) : 63.875f) + pp[6];
+        mn = pp[7] < 63.875f ? pp[7] : 63.875f;
+        mx = pp[3] + mn < 63.875f ? pp[3] + mn : 63.875f;
+        sz = sz * pp[3] + pp[7];
+        sz = sz < mn ? mn : sz > mx ? mx : sz;
+    }
+    if (!(sz >= 1.0f))
+        sz = 1.0f;                                          /* NaN too */
+    return sz > 63.875f ? 63.875f : sz;
+}
