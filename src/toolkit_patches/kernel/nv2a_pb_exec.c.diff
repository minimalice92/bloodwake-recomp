+static float bw_poly_offset(const float *a, const float *b, const float *c, float area)
+{
+    float factor, units, dzdx, dzdy;
+    if (!bw_poly_offset_on())
+        return 0.0f;
+    factor = reg_f(0x0384);
+    units = reg_f(0x0388);
+    dzdx = ((b[2] - a[2]) * (c[1] - a[1]) - (c[2] - a[2]) * (b[1] - a[1])) / area;
+    dzdy = ((c[2] - a[2]) * (b[0] - a[0]) - (b[2] - a[2]) * (c[0] - a[0])) / area;
+    dzdx = fabsf(dzdx) * aa_scale_x();
+    dzdy = fabsf(dzdy) * aa_scale_y();
+    return units + factor * (dzdx > dzdy ? dzdx : dzdy);
+}
